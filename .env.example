# ─────────────────────────────────────────────────────────────
# SS Health Care CRM — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# Never commit your actual .env to Git!
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Supabase (required — app will crash without these)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# App Mode: "admin" for internal CRM | "public" for patient-facing site
VITE_APP_MODE=admin

# Meta / WhatsApp Business API (Phase 2 — leave as-is for now)
META_SYSTEM_TOKEN=YOUR_META_SYSTEM_TOKEN
META_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
META_WABA_ID=YOUR_META_WABA_ID
