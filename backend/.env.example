PORT=3001
NODE_ENV=development

# Supabase backend key. Use service_role locally/server-side, not in frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional emergency admin fallback for internal login only.
ADMIN_FALLBACK_USERNAME=admin
ADMIN_FALLBACK_PASSWORD=change-this-before-handover
ADMIN_FALLBACK_SESSION_TOKEN=replace-with-a-long-random-token

# Optional: protect Callyzer webhook URL with this secret.
CALLYZER_WEBHOOK_SECRET=change-this-secret

# Required only for manual backfill sync endpoint /api/callyzer/sync.
CALLYZER_API_TOKEN=YOUR_CALLYZER_API_TOKEN
CALLYZER_CALL_HISTORY_URL=https://api1.callyzer.co/api/v2.1/callHistory
