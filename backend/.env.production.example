# Backend production env — keep server-side only
NODE_ENV=production
PORT=3001

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Callyzer is deferred until final integration phase
CALLYZER_WEBHOOK_SECRET=replace-with-strong-secret
CALLYZER_API_TOKEN=
CALLYZER_API_BASE_URL=https://api1.callyzer.co/api/v2.1

# Meta WhatsApp API is deferred until final integration phase
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_VERIFY_TOKEN=
META_WA_APP_SECRET=
